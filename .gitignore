# Keep source snapshots, data/rebuild support, corpus, frozen models and metrics.
# Only the four approved shared tables belong in data/processed.
/data/processed/**
!/data/processed/wti_daily.parquet
!/data/processed/wti_daily.csv
!/data/processed/features.csv
!/data/processed/wti_publication.csv

# Generated data releases belong in .local, not beside the approved tables.
/data/interim/
/data/.*_rebuild/

# Presentation/video render caches; source assets and model figures are retained.
**/previews/
/m4_reports/video/media/
/m4_reports/video/build/

# Course presentation and personal rehearsal material stay private.
/m4_reports/deliverables/
/m4_reports/brand/
/m4_reports/slides/
/m4_reports/video/
/m4_reports/team.json
/m4_reports/final_speaker_plan.json
/m4_reports/slide_reading_notes.json
